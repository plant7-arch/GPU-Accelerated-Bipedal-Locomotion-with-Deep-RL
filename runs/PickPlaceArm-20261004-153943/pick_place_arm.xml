<mujoco model="pick_place_arm">
  <!--
    6-DoF arm + 2-finger parallel gripper on a table, with a graspable cube and a goal marker.
    Written to be MJX-friendly (JAX implementation):
      * only box / capsule / plane geoms in collisions (box-box for hand<->cube<->table),
      * position actuators, implicitfast integrator, small solver iteration counts,
      * arm links are visual/inertial only (no collisions); the env terminates if the elbow/wrist
        would go through the table.

    Joint / actuator order (the Python env relies on it):
      qpos: joint1..joint6 | finger_l_joint, finger_r_joint | cube_free (7: xyz + quat wxyz)
      ctrl: act_joint1..act_joint6 | act_finger_l, act_finger_r

    Zero configuration = arm pointing straight up. Tool axis is the hand's +z; the fingers open
    along the hand's y axis. A top-down grasp therefore needs  joint2 + joint3 + joint5 = pi.
  -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.004" integrator="implicitfast" solver="Newton" cone="pyramidal"
          iterations="10" ls_iterations="10"/>

  <statistic center="0.4 0 0.1" extent="1.0"/>
  <visual>
    <global azimuth="140" elevation="-25"/>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.45 0.62 0.80" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture name="grid" type="2d" builtin="checker" mark="edge" rgb1="0.15 0.2 0.25"
             rgb2="0.2 0.27 0.33" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="6 6" reflectance="0.15"/>
  </asset>

  <!--
    Collision bitmasks (two geoms collide if  contype_a & conaffinity_b  or  contype_b & conaffinity_a):
      table  contype 1  affinity 14 (cube, links, hand)     cube  contype 2  affinity 13 (table, links, hand)
      hand   contype 8  affinity 3  (table, cube)
    Everything else (arm links, floor, goal marker) is non-colliding.
  -->
  <default>
    <joint damping="1" armature="0.01"/>
    <geom contype="0" conaffinity="0"/>

    <default class="link">
      <geom rgba="0.82 0.84 0.90 1" density="700"/>
    </default>

    <default class="shoulder">
      <joint damping="3" armature="0.05" frictionloss="0.2"/>
      <position kp="600" kv="60" forcerange="-90 90"/>
    </default>
    <default class="elbow">
      <joint damping="2" armature="0.03" frictionloss="0.15"/>
      <position kp="500" kv="50" forcerange="-70 70"/>
    </default>
    <default class="wrist">
      <joint damping="0.5" armature="0.01" frictionloss="0.05"/>
      <position kp="120" kv="12" forcerange="-20 20"/>
    </default>
    <default class="finger">
      <joint type="slide" damping="2" armature="0.005"/>
      <position kp="500" kv="15" forcerange="-40 40"/>
    </default>

    <default class="hand_col">
      <geom contype="8" conaffinity="3" friction="1.0 0.005 0.0001" rgba="0.15 0.15 0.18 1"/>
    </default>
  </default>

  <worldbody>
    <light pos="0.5 0 2" dir="0 0 -1" directional="true" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="3 3 0.1" pos="0 0 -0.75" material="grid"/>

    <!-- Table: top surface at z = 0 -->
    <geom name="table" type="box" pos="0.325 0 -0.025" size="0.475 0.45 0.025"
          rgba="0.65 0.5 0.35 1" friction="0.8 0.005 0.0001" contype="1" conaffinity="14"/>

    <!-- Arm base (visual only) -->
    <geom name="base_pedestal" type="cylinder" pos="0 0 0.03" size="0.07 0.03" rgba="0.3 0.3 0.35 1"/>

    <!-- ===================== 6-DoF arm ===================== -->
    <body name="link1" pos="0 0 0.06">
      <joint name="joint1" class="shoulder" axis="0 0 1" range="-2.8 2.8"/>
      <geom class="link" type="capsule" fromto="0 0 0 0 0 0.12" size="0.05"/>
      <body name="link2" pos="0 0 0.12">
        <joint name="joint2" class="shoulder" axis="0 1 0" range="-1.0 1.8"/>
        <geom class="link" type="capsule" fromto="0 0 0 0 0 0.30" size="0.04"/>
        <body name="link3" pos="0 0 0.30">
          <joint name="joint3" class="elbow" axis="0 1 0" range="-0.2 2.6"/>
          <geom class="link" type="capsule" fromto="0 0 0 0 0 0.24" size="0.033"/>
          <body name="link4" pos="0 0 0.24">
            <joint name="joint4" class="wrist" axis="0 0 1" range="-1.5 1.5"/>
            <geom class="link" type="capsule" fromto="0 0 0 0 0 0.07" size="0.028"/>
            <body name="link5" pos="0 0 0.07">
              <joint name="joint5" class="wrist" axis="0 1 0" range="-1.6 2.4"/>
              <geom class="link" type="capsule" fromto="0 0 0 0 0 0.06" size="0.026"/>

              <!-- ===================== hand + parallel gripper ===================== -->
              <body name="hand" pos="0 0 0.06">
                <joint name="joint6" class="wrist" axis="0 0 1" range="-3.0 3.0"/>
                <geom name="palm" class="hand_col" type="box" size="0.025 0.06 0.02" pos="0 0 0.02" mass="0.3"/>
                <!-- grasp point: between the fingertips, along the tool axis -->
                <site name="grip_site" pos="0 0 0.095" size="0.006" rgba="1 0.2 0.2 0.8"/>

                <!-- Fingers close along the hand y axis. q = 0 -> closed (gap 8 mm), q = 0.04 -> open (gap 88 mm) -->
                <body name="finger_l" pos="0 0.012 0.04">
                  <joint name="finger_l_joint" class="finger" axis="0 1 0" range="0 0.04"/>
                  <geom name="finger_l_geom" class="hand_col" type="box" size="0.012 0.008 0.035"
                        pos="0 0 0.035" mass="0.05"/>
                </body>
                <body name="finger_r" pos="0 -0.012 0.04">
                  <joint name="finger_r_joint" class="finger" axis="0 -1 0" range="0 0.04"/>
                  <geom name="finger_r_geom" class="hand_col" type="box" size="0.012 0.008 0.035"
                        pos="0 0 0.035" mass="0.05"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- ===================== object to pick (4 cm cube, 100 g) ===================== -->
    <body name="cube" pos="0.4 0 0.02">
      <freejoint name="cube_free"/>
      <geom name="cube_geom" type="box" size="0.02 0.02 0.02" mass="0.1" rgba="0.9 0.2 0.2 1"
            friction="1.0 0.005 0.0001" contype="2" conaffinity="13"/>
    </body>

    <!-- ===================== goal marker (mocap, never collides) ===================== -->
    <body name="goal" mocap="true" pos="0.4 0.15 0.002">
      <geom name="goal_marker" type="box" size="0.025 0.025 0.002" rgba="0.1 0.9 0.2 0.5"/>
    </body>

    <camera name="overview" pos="1.05 -0.85 0.65" xyaxes="0.785 0.619 0.000 -0.288 0.366 0.885"/>
  </worldbody>

  <actuator>
    <position name="act_joint1" class="shoulder" joint="joint1" ctrlrange="-2.8 2.8"/>
    <position name="act_joint2" class="shoulder" joint="joint2" ctrlrange="-1.0 1.8"/>
    <position name="act_joint3" class="elbow"    joint="joint3" ctrlrange="-0.2 2.6"/>
    <position name="act_joint4" class="wrist"    joint="joint4" ctrlrange="-1.5 1.5"/>
    <position name="act_joint5" class="wrist"    joint="joint5" ctrlrange="-1.6 2.4"/>
    <position name="act_joint6" class="wrist"    joint="joint6" ctrlrange="-3.0 3.0"/>
    <position name="act_finger_l" class="finger" joint="finger_l_joint" ctrlrange="0 0.04"/>
    <position name="act_finger_r" class="finger" joint="finger_r_joint" ctrlrange="0 0.04"/>
  </actuator>

  <!-- Home pose: tool pointing down, hovering at (0.40, 0, 0.15); gripper open; cube on the table. -->
  <keyframe>
    <key name="home"
         qpos="0 0.437 1.6271 0 1.0775 0  0.04 0.04  0.4 0 0.02 1 0 0 0"
         ctrl="0 0.437 1.6271 0 1.0775 0  0.04 0.04"/>
  </keyframe>
</mujoco>
